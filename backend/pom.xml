<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.3</version>
        <relativePath/>
    </parent>

    <groupId>com.clele</groupId>
    <artifactId>parts</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>parts</name>
    <description>Electronic Parts Stock Management</description>

    <properties>
        <java.version>21</java.version>
        <!-- Frontend (React/Vite) build wiring -->
        <node.version>v22.12.0</node.version>
        <frontend.dir>${project.basedir}/../frontend</frontend.dir>
        <!-- Set -DskipFrontend=true to skip the npm build (e.g. for fast backend-only dev runs) -->
        <skipFrontend>false</skipFrontend>
        <!-- Print daemon (Go) build wiring -->
        <daemon.dir>${project.basedir}/../daemon</daemon.dir>
        <!-- Set -DskipDaemon=true to skip building the daemon download (requires a Go toolchain) -->
        <skipDaemon>false</skipDaemon>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Sends organisation invitation mails. Optional at runtime: without an SMTP host
             configured the app logs the invitation link instead of sending it. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- Persist HTTP sessions to PostgreSQL so logins survive app restarts (schema = Flyway V16) -->
        <dependency>
            <groupId>org.springframework.session</groupId>
            <artifactId>spring-session-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <!-- Decodes the Partsbox WebSocket Transit+JSON capture (data.txt). Not in the Spring BOM, so pin the version. -->
        <dependency>
            <groupId>com.cognitect</groupId>
            <artifactId>transit-java</artifactId>
            <version>1.0.371</version>
        </dependency>
<dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.3.0</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Builds the React/Vite frontend (../frontend) during the Maven build.
                 Downloads a private Node into target/, runs `npm install` + `npm run build`. -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>1.15.1</version>
                <configuration>
                    <workingDirectory>${frontend.dir}</workingDirectory>
                    <installDirectory>${project.build.directory}</installDirectory>
                    <skip>${skipFrontend}</skip>
                </configuration>
                <executions>
                    <execution>
                        <id>install-node-and-npm</id>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <nodeVersion>${node.version}</nodeVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-install</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <arguments>install</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-build</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Copies the built frontend (../frontend/dist) into the app's static resources
                 so the single Spring Boot jar serves the UI alongside the API. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-frontend-build</id>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <phase>process-resources</phase>
                        <configuration>
                            <skip>${skipFrontend}</skip>
                            <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${frontend.dir}/dist</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <!-- Copies the packaged daemon download (see maven-antrun-plugin below) into the
                         app's static resources so it's downloadable from the running app itself. -->
                    <execution>
                        <id>copy-daemon-download</id>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <phase>process-resources</phase>
                        <configuration>
                            <skip>${skipDaemon}</skip>
                            <outputDirectory>${project.build.outputDirectory}/static/downloads</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.build.directory}/daemon-package</directory>
                                    <includes>
                                        <include>clele-print-daemon.tar.gz</include>
                                    </includes>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Builds the print daemon (../daemon, Go) during the Maven build: a single static
                 Linux/amd64 binary, no JVM/Python involved. Requires a `go` toolchain on PATH. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.1</version>
                <executions>
                    <execution>
                        <id>build-daemon</id>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <skip>${skipDaemon}</skip>
                            <executable>go</executable>
                            <workingDirectory>${daemon.dir}</workingDirectory>
                            <arguments>
                                <argument>build</argument>
                                <argument>-ldflags</argument>
                                <argument>-X main.version=${daemon.version}</argument>
                                <argument>-o</argument>
                                <argument>${project.build.directory}/daemon-dist/clele-print-daemon</argument>
                                <argument>./cmd/clele-print-daemon</argument>
                            </arguments>
                            <environmentVariables>
                                <GOOS>linux</GOOS>
                                <GOARCH>amd64</GOARCH>
                            </environmentVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Bundles the daemon binary + installer + systemd unit + README into the single
                 tar.gz that copy-daemon-download (above) exposes at /downloads/. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <!-- Derives the daemon's version from the timestamp of the last commit that
                         actually touched daemon/ — so it changes only when the daemon source
                         changes, not on every build. The same value is baked into the Go binary
                         (ldflags, below) and written to the backend's classpath as the *expected*
                         version, so the app can warn about daemons running an older build.
                         NOTE: uncommitted daemon changes don't move the version; commit them.
                         Deliberately not skipped by -DskipDaemon so the backend always knows what
                         version it expects, even in fast frontend-less dev builds. -->
                    <execution>
                        <id>daemon-version</id>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <phase>initialize</phase>
                        <configuration>
                            <exportAntProperties>true</exportAntProperties>
                            <target>
                                <exec executable="git" dir="${project.basedir}/.."
                                      outputproperty="git.daemon.version"
                                      failifexecutionfails="false" failonerror="false">
                                    <arg value="log"/>
                                    <arg value="-1"/>
                                    <arg value="--format=%cd"/>
                                    <arg value="--date=format:%Y%m%d.%H%M%S"/>
                                    <arg value="--"/>
                                    <arg value="daemon"/>
                                </exec>
                                <!-- Ant properties are write-once: the condition wins when git
                                     produced a real value, otherwise the literal below applies
                                     (no git, not a checkout, or daemon/ not committed yet). -->
                                <condition property="daemon.version" value="${git.daemon.version}">
                                    <and>
                                        <isset property="git.daemon.version"/>
                                        <not><equals arg1="${git.daemon.version}" arg2="" trim="true"/></not>
                                    </and>
                                </condition>
                                <property name="daemon.version" value="unknown"/>
                                <echo level="info">Daemon version: ${daemon.version}</echo>
                                <mkdir dir="${project.build.outputDirectory}"/>
                                <echo file="${project.build.outputDirectory}/daemon-version.txt"
                                      message="${daemon.version}"/>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>package-daemon</id>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <skip>${skipDaemon}</skip>
                            <target>
                                <chmod file="${project.build.directory}/daemon-dist/clele-print-daemon" perm="755"/>
                                <copy todir="${project.build.directory}/daemon-dist">
                                    <fileset dir="${daemon.dir}">
                                        <include name="install.sh"/>
                                        <include name="clele-print-daemon.service"/>
                                        <include name="README.md"/>
                                    </fileset>
                                </copy>
                                <chmod file="${project.build.directory}/daemon-dist/install.sh" perm="755"/>
                                <mkdir dir="${project.build.directory}/daemon-package"/>
                                <tar destfile="${project.build.directory}/daemon-package/clele-print-daemon.tar.gz"
                                     compression="gzip">
                                    <tarfileset dir="${project.build.directory}/daemon-dist" filemode="755">
                                        <include name="clele-print-daemon"/>
                                        <include name="install.sh"/>
                                    </tarfileset>
                                    <tarfileset dir="${project.build.directory}/daemon-dist">
                                        <include name="clele-print-daemon.service"/>
                                        <include name="README.md"/>
                                    </tarfileset>
                                </tar>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
