# Copy to /etc/clele/clele.env on the server and fill in real values, then `chmod 600` it.
# Read by the systemd unit (EnvironmentFile). Keep this file OFF the public web and out of git.

SPRING_PROFILES_ACTIVE=prod

# PostgreSQL on the server (the prod profile defaults DB_URL/DB_USER to these if unset).
DB_URL=jdbc:postgresql://localhost:5432/partsdb
DB_USER=partsuser
DB_PASSWORD=change-me

# Anthropic API key for AI part search (leave blank to disable AI features).
ANTHROPIC_API_KEY=sk-ant-...

# --- Outgoing mail (invitations) ---------------------------------------------------------------
# Which provider delivers mail: smtp | mailersend | none. With `none` — or `smtp` while MAIL_HOST
# is blank — nothing is sent: the invitation link is written to the log and shown to the admin in
# the invite dialog instead.
MAIL_PROVIDER=smtp

# SMTP server. MAIL_HOST is what actually switches sending on.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=change-me
# STARTTLS on port 587 (the usual). For implicit TLS on 465 set MAIL_STARTTLS=false and add
# `spring.mail.properties.mail.smtp.ssl.enable=true` — there is no env var for that yet.
MAIL_AUTH=true
MAIL_STARTTLS=true

# Sender as the recipient sees it. Use the public product name, never "Clele".
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Sortiment

# Public URL of this installation, used to build the invitation link. Set it whenever the app sits
# behind a proxy — otherwise the link is derived from the request and points at the internal host.
APP_BASE_URL=https://parts.example.com

# MailerSend instead of SMTP (MAIL_PROVIDER=mailersend). The MAIL_FROM domain must be verified in
# the MailerSend account, or the API rejects every send with HTTP 422.
#MAILERSEND_API_KEY=mlsn....
